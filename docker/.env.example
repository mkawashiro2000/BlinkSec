# BlinkSec — copiar a .env y rellenar. NUNCA commitear .env.
#   cp .env.example .env && chmod 600 .env

# --- Red / TLS ---------------------------------------------------------------
N8N_HOST=soar.example.com
ACME_EMAIL=soc@example.com
TZ=Europe/Madrid

# CIDRs de los colectores SIEM autorizados a POSTear alertas (separados por espacio).
SIEM_ALLOWLIST=10.20.0.5/32 10.20.0.6/32

# CIDRs desde los que se puede abrir el editor de n8n.
MGMT_ALLOWLIST=10.10.0.0/24

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=blinksec
POSTGRES_USER=blinksec
POSTGRES_PASSWORD=            # openssl rand -base64 32

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=               # openssl rand -base64 32

# --- n8n ---------------------------------------------------------------------
# Si se pierde, TODAS las credenciales guardadas en n8n son irrecuperables.
N8N_ENCRYPTION_KEY=           # openssl rand -base64 32

# --- Secretos HMAC de ingesta (uno por plataforma de origen) --------------
# El mismo valor debe configurarse en el emisor (Better Webhooks, conector
# de Kibana, send_to_blinksec.py). Rotar de forma independiente por
# plataforma. Wazuh se retiró como fuente de ingesta — ver docs/riesgos.md.
BLINKSEC_HMAC_SECRET_SPLUNK=   # openssl rand -hex 32
BLINKSEC_HMAC_SECRET_ELASTIC=  # openssl rand -hex 32

# Ventana de tolerancia para X-BlinkSec-Timestamp, en segundos.
BLINKSEC_REPLAY_WINDOW_SECONDS=300

# Autoriza la reanudación del Human-in-the-Loop (WF-05). OBLIGATORIO: sin él
# WF-05 falla en vez de mandar un botón que cualquiera podría pulsar. La URL
# del nodo Wait es adivinable por sí sola (executionId secuencial + sufijo
# constante), este token es lo que la protege.
BLINKSEC_HITL_TOKEN_SECRET=    # openssl rand -hex 32

# Token estático de ingesta de Elastic. Kibana rellena plantillas pero NO
# ejecuta código, así que no puede calcular un HMAC sobre el cuerpo: sólo puede
# mandar un valor fijo. Postura de seguridad realmente inferior a la de Splunk
# (no cubre el cuerpo ni protege contra reenvío dentro de la ventana). Dejar
# VACÍO si no se usa Elastic — con el valor vacío, la ingesta de Elastic queda
# deshabilitada en vez de aceptar cualquier cosa. Ver R-01 en docs/riesgos.md.
BLINKSEC_STATIC_TOKEN_ELASTIC=  # openssl rand -hex 32

# --- Claves de inteligencia de amenazas --------------------------------------
# Se cargan como credenciales de n8n, no como env. Se listan aquí sólo para
# los scripts de prueba de tests/. GreyNoise e IBM X-Force se retiraron del
# sistema — ver docs/riesgos.md (R-14, R-17).
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
CROWDSEC_API_KEY=

# --- Destinos de respuesta ---------------------------------------------------
# TheHive y Wazuh se retiraron del sistema — ver docs/riesgos.md (R-19). Sin
# plataforma externa de tickets ni contención vía Wazuh conectadas todavía.
SLACK_BOT_TOKEN=
SLACK_SOC_CHANNEL=#soc-alerts
SLACK_ONCALL_CHANNEL=#soc-guardia
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
