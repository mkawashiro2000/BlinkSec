# Secrets — never commit
.env
.env.*
!.env.example
docker/.env
docker/.env.*
!docker/.env.example
*.key
*.pem
*.p12
*.pfx
**/credentials*.json
*.secrets.json

# Override de puertos/entorno sólo para pruebas locales (ver Fase 7: puertos
# 80/443 ocupados por otros servicios del host). Nunca representa producción.
docker/docker-compose.override.yml

# Workflow exports may contain embedded credentials if exported wrong.
# Only the sanitized files under workflows/ are tracked; scratch exports are not.
workflows/*.raw.json
workflows/_export/

# Runtime
node_modules/
data/
postgres-data/
redis-data/
caddy-data/
n8n-data/
*.log

# OS
.DS_Store

# Editores
*.swp
*.swo
